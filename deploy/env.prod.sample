## Production environment configuration template
## 복사하여 deploy/.env.prod 로 저장하고 필요한 시크릿 값을 채우세요.
## cp deploy/env.prod.sample deploy/.env.prod

# Database (PostgreSQL 16.4)
POSTGRES_DB=prod_dormmate
POSTGRES_USER=dormmate_user
POSTGRES_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_URL=jdbc:postgresql://db:5432/prod_dormmate
DB_USERNAME=dormmate_user
DB_PASSWORD=replace-with-strong-db-password

# Flyway Production Migration Location
FLYWAY_LOCATIONS=classpath:db/production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Security
# 256비트(32바이트) 이상의 강력한 난수 시크릿 키를 지정하세요.
JWT_SECRET=replace-with-minimum-32-character-random-secret-key-prod
JWT_EXPIRATION=45000
JWT_REFRESH_EXPIRATION=300000

# CORS Allowed Origins (운영 도메인)
CORS_ALLOWED_ORIGINS=https://dormmate.example.com,http://localhost:8080

# Frontend / Proxy
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_FIXTURE=0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
SERVER_NAME=dormmate.example.com
ENABLE_TLS=false
TLS_DOMAIN=
TLS_EMAIL=
TLS_SELF_SIGNED=true

# Logging & Timezone
LOG_LEVEL=info
TZ=UTC

# Admin Bootstrap (선택: 최초 관리자 발급 시 사용)
# docker-compose.bootstrap.yml을 추가할 때만 활성화됩니다.
# DORMMATE_BOOTSTRAP_LOGIN_ID=initial-admin
# ADMIN_BOOTSTRAP_PASSWORD_SOURCE=/absolute/private/path/admin_password.txt
# DORMMATE_BOOTSTRAP_NAME='System Administrator'
# DORMMATE_BOOTSTRAP_EMAIL=admin@dormmate.example.com
